{
  "name": "42-norm-formatter",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.4",
  "publisher": "harnakam",
  "icon": "assets/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/harnakam/42-norm-formatter",
  "bugs": {
    "url": "https://github.com/harnakam/42-norm-formatter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harnakam/42-norm-formatter.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onCommand:normFormatter.showMenu",
    "onCommand:normFormatter.runCurrentFile",
    "onCommand:normFormatter.runWorkspace",
    "workspaceContains:**/*.c",
    "workspaceContains:**/*.h"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "normFormatter.showMenu",
        "title": "%command.showMenu.title%"
      },
      {
        "command": "normFormatter.runCurrentFile",
        "title": "%command.runCurrentFile.title%"
      },
      {
        "command": "normFormatter.runWorkspace",
        "title": "%command.runWorkspace.title%"
      },
      {
        "command": "normFormatter.formatDocument",
        "title": "%command.formatDocument.title%"
      },
      {
        "command": "normFormatter.configure",
        "title": "%command.configure.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "normFormatter.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "%config.pythonPath.description%"
        },
        "normFormatter.useGitignore": {
          "type": "boolean",
          "default": true,
          "description": "%config.useGitignore.description%"
        },
        "normFormatter.compatibilityRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%config.compatibilityRules.description%"
        },
        "normFormatter.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.formatOnSave.description%"
        },
        "normFormatter.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.lintOnSave.description%"
        },
        "normFormatter.lintOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%config.lintOnOpen.description%"
        },
        "normFormatter.lintOnChange": {
          "type": "boolean",
          "default": false,
          "description": "%config.lintOnChange.description%"
        },
        "normFormatter.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBar.description%"
        },
        "normFormatter.traceRunner": {
          "type": "boolean",
          "default": false,
          "description": "%config.traceRunner.description%"
        },
        "normFormatter.headerEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.headerEnabled.description%"
        },
        "normFormatter.headerUsername": {
          "type": "string",
          "default": "username",
          "description": "%config.headerUsername.description%"
        },
        "normFormatter.headerEmail": {
          "type": "string",
          "default": "username@student.42tokyo.jp",
          "description": "%config.headerEmail.description%"
        },
        "normFormatter.removeFunctionScopeComments": {
          "type": "boolean",
          "default": false,
          "description": "%config.removeFunctionScopeComments.description%"
        },
        "normFormatter.wrapSingleStatementBodies": {
          "type": "boolean",
          "default": false,
          "description": "%config.wrapSingleStatementBodies.description%"
        },
        "normFormatter.splitMultiInstructions": {
          "type": "boolean",
          "default": false,
          "description": "%config.splitMultiInstructions.description%"
        },
        "normFormatter.splitDeclarationAssignment": {
          "type": "boolean",
          "default": false,
          "description": "%config.splitDeclarationAssignment.description%"
        },
        "normFormatter.hoistDeclarationsToFunctionTop": {
          "type": "boolean",
          "default": false,
          "description": "%config.hoistDeclarationsToFunctionTop.description%"
        },
        "normFormatter.rewriteForToWhile": {
          "type": "boolean",
          "default": false,
          "description": "%config.rewriteForToWhile.description%"
        },
        "normFormatter.allowUnsafeTransforms": {
          "type": "boolean",
          "default": false,
          "description": "%config.allowUnsafeTransforms.description%",
          "markdownDeprecationMessage": "%config.allowUnsafeTransforms.deprecation%"
        }
      }
    }
  }
}
